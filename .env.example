# Copy to .env.local for local development. Never commit real values.

# --- Database ---
# Matches docker-compose.yml defaults. Change if you run Postgres elsewhere.
DATABASE_URL=postgres://outreach:outreach_dev_only@localhost:5432/outreach_engine

# --- Session / Auth ---
# Random 32+ byte secret used to sign session cookies (HS256).
# Generate one locally, e.g.: openssl rand -base64 32
SESSION_SECRET=

# --- Development seed accounts (optional) ---
# If set, scripts/seed.ts uses these as the OWNER account's local dev password
# instead of generating a random one. Never set this in a shared/deployed
# environment.
SEED_OWNER_PASSWORD=

# --- AI Providers (Phase 1: NOT configured, adapters are stubs) ---
# Names only — no values are required or used in Phase 1. Setting one of
# these does not make the provider "AVAILABLE"; it is one of three
# conditions (adapter + credentials + approval) defined in
# docs/MODEL_CONTROL_PLANE.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
