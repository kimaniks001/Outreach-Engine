# Copy to .env.local for local development. Never commit real values.

# --- Database ---
# Matches docker-compose.yml defaults. Change if you run Postgres elsewhere.
DATABASE_URL=postgres://outreach:outreach_dev_only@localhost:5432/outreach_engine

# --- Session / Auth ---
# Random 32+ byte secret used to sign staff session cookies (HS256).
# Generate one locally, e.g.: openssl rand -base64 32
SESSION_SECRET=

# --- Development seed accounts (optional) ---
# If set, scripts/seed.ts uses these as the OWNER account's local dev password
# instead of generating a random one. Never set this in a shared/deployed
# environment.
SEED_OWNER_PASSWORD=

# --- SecurePay Market Network / Community authority bridge ---
# API root INCLUDING /api/v1, for example:
# SECUREPAY_API_BASE_URL=http://localhost:8080/api/v1
#
# Market Network sign-in uses SecurePay's existing KS Number + password + MFA
# flow. Access/refresh tokens are held in httpOnly Outreach cookies and are
# propagated only as the current caller. There is deliberately no shared
# service token for Community membership, moderation or feed authority.
SECUREPAY_API_BASE_URL=
# Optional application id forwarded to SecurePay authentication when Outreach
# has a registered application identity. Leave unset until one exists.
SECUREPAY_OUTREACH_APPLICATION_ID=

# --- WhatsApp Business Platform / Cloud API ---
# Secrets are deployment configuration only. Never commit real values.
# WHATSAPP_VERIFY_TOKEN is chosen by us and configured in the Meta webhook.
# WHATSAPP_APP_SECRET verifies X-Hub-Signature-256 callbacks.
# WHATSAPP_GRAPH_API_VERSION is explicit so upgrades are deliberate rather than
# silently relying on a stale hard-coded version.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
# Normally leave this unchanged. It exists for controlled test/sandbox routing.
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

# --- WhatsApp support workers / SecurePay support truth ---
# Protects the private queue-drain endpoint. Use a long random deployment secret.
SUPPORT_WORKER_SECRET=
# Separate 32+ byte HMAC secret used only for SecurePay-authoritative channel
# identity assertions sent to
# POST /api/internal/support/whatsapp/identity-binding.
# SecurePay signs the exact raw JSON body in X-SecurePay-Signature-256 as
# `sha256=<hex-hmac>`. This secret must never be reused as SUPPORT_WORKER_SECRET.
SECUREPAY_CHANNEL_BINDING_SECRET=
# Optional until a dedicated SecurePay support/service principal is provisioned.
# It MUST have SUPPORT_CONTEXT_READ only (or an equivalently narrow support-read
# grant) and MUST NOT carry agreement mutation, payment, release, settlement,
# identity-lifecycle, compliance-decision or administrator authority.
# If absent, automated customer-specific answers fail closed into a human queue.
SECUREPAY_AUTOMATED_SUPPORT_TOKEN=

# --- AI Providers ---
# Names only — no values are committed here. Setting one of these does not
# by itself make the provider "AVAILABLE"; it is one of three conditions
# (adapter + credentials + enabled) defined in docs/MODEL_CONTROL_PLANE.md.
#
# ANTHROPIC_API_KEY is the only one with a live adapter as of Phase 2 — see
# docs/PHASE_2_AI_PROVIDER_INTEGRATION.md. It is entirely optional: with it
# unset, the app is fully usable via the built-in mock/test AI provider
# (no credentials needed, always available, clearly labeled MOCK in the UI).
# OPENAI_API_KEY / GOOGLE_AI_API_KEY remain non-live stubs from Phase 1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- Phase 4: Product Event Ingestion (optional) ---
# Shared secret for a real SecurePay-to-Outreach-Engine server-to-server
# integration — see docs/PHASE_4_PRODUCT_EVENT_INTEGRATION.md. Entirely
# optional: with it unset, POST /api/product-events still works for an
# authenticated Owner session (e.g. the demo simulator); no credentials are
# required to complete Phase 4.
PRODUCT_EVENT_INGESTION_SECRET=

# --- Production bootstrap (production only — never set locally) ---
# Consumed exactly once by `npm run db:bootstrap`
# (scripts/bootstrap-production.ts) to create the first Owner account on a
# freshly migrated production database. Not read anywhere else in the app.
# See docs/PRODUCTION_READINESS_REVIEW.md and docs/INITIAL_LAUNCH_RUNBOOK.md.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
